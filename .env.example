# SigNoz SRE Copilot - Environment Configuration

# SigNoz MCP Server
SIGNOZ_MCP_URL=http://localhost:8000
SIGNOZ_API_KEY=your-signoz-api-key-here

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sre-copilot
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=hackathon,team=manish-kumar

# LLM (for CrewAI)
OPENAI_API_KEY=sk-your-openai-key

# Remediation Safety
REMEDIATION_DRY_RUN=false
ALLOWED_NAMESPACES=default,hackathon-demo
MAX_RETRIES=3

# Validation
VALIDATION_TIMEOUT=300
CHECK_INTERVAL=30

# Kubernetes
KUBECONFIG=~/.kube/config
