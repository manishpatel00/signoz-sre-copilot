# SigNoz SRE Copilot - Environment Configuration

# SigNoz MCP Server
SIGNOZ_MCP_URL=http://localhost:8000
SIGNOZ_API_KEY=your-signoz-api-key-here

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sre-copilot
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=hackathon,team=your-team

# LLM Configuration (choose one)
# Option 1: Groq (recommended - free tier available)
GROQ_API_KEY=your-groq-api-key
# Option 2: Gemini
GEMINI_API_KEY=your-gemini-api-key
# Option 3: OpenAI
OPENAI_API_KEY=your-openai-api-key

# Mock LLM fallback (set true to bypass LLM for testing)
MOCK_LLM=false

# Remediation Safety
REMEDIATION_DRY_RUN=true
ALLOWED_NAMESPACES=default,hackathon-demo
MAX_RETRIES=3

# Validation
VALIDATION_TIMEOUT=300
CHECK_INTERVAL=30

# Kubernetes
KUBECONFIG=~/.kube/config
